<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything this project needs from the engine - the runtime and its
       generators and analyzers, the AOT posture, and the mirrors of exactly
       the extensions project_settings.yaml loads (the renderer's data crate;
       this project lists no modules) - comes from the shared import the other
       examples use. It reads the settings file while MSBuild evaluates the
       project, so no hand-written glob decides which mirrors compile.
       PillEngineRoot only locates the import: the host and the shipping build
       pass it, and this fallback serves an IDE build. -->
  <PropertyGroup>
    <PillEngineRoot Condition="'$(PillEngineRoot)' == ''">../../../modules/</PillEngineRoot>
  </PropertyGroup>
  <Import Project="$(PillEngineRoot)csharp/Pill.CSharp.props" />

</Project>
