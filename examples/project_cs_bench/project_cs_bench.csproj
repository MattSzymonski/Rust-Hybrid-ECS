<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the engine needs from a C# project comes from one shared
       import; see examples/project_cs. PillEngineRoot only locates it: the
       host and the release script pass it, and this fallback serves an IDE
       build.

       No extension mirrors: the benchmark measures managed iteration alone,
       so it draws nothing and imports no renderer component, and its
       `modules: []` leaves nothing else to mirror. -->
  <PropertyGroup>
    <PillEngineRoot Condition="'$(PillEngineRoot)' == ''">../../modules/</PillEngineRoot>
    <PillExtensionMirrors>false</PillExtensionMirrors>
  </PropertyGroup>
  <Import Project="$(PillEngineRoot)csharp/Pill.CSharp.props" />

</Project>
