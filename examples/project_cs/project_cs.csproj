<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Deliberately omitted: AllowUnsafeBlocks. This is the assembly you
         edit constantly (Systems.cs) and hot-reload while the host runs —
         it must not be able to construct raw pointers, so the compiler
         itself refuses to build unsafe code here. See
         csharp_features.md's "Trust and sandboxing model" section. -->

    <!-- This is a library, but the Rust host loads it via hostfxr, which
         needs a runtimeconfig.json describing the target framework. -->
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <!-- For Engine.cs's safe generic query facade. Project-specific component
         structs live in this reloadable project. -->
    <ProjectReference Include="../../modules/pill_csharp_runtime/csharp_runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auto-generated mirrors of components exposed by optional Rust modules.
         The Rust host writes generated/<module>_Components.g.cs inside each
         optional module before the project build, deriving every declaration
         from the module's real registered layout; nothing is hand-written in
         this project. A committed copy bootstraps standalone builds. -->
    <Compile Include="../../modules/optional/*/generated/*.g.cs" />
  </ItemGroup>

</Project>
