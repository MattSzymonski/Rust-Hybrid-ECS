{
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "command": "python .claude/run_hook.py gate_guard",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "python .claude/run_hook.py unattended_guard",
        "timeout": 10
      },
      {
        "type": "command",
        "command": "python .claude/run_hook.py activity --agent copilot",
        "timeout": 5
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "python .claude/run_hook.py activity --agent copilot",
        "timeout": 5
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "python .claude/run_hook.py activity --agent copilot",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python .claude/run_hook.py activity --agent copilot",
        "timeout": 5
      }
    ]
  }
}
