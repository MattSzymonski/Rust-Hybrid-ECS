{
    // Debug configurations for the standalone host.
    //
    // `cargo run` from a terminal attaches no debugger, so editor breakpoints
    // never bind. Launch through the Run and Debug panel (F5) with one of
    // these instead.
    //
    // `cppvsdbg` requires the "C/C++" extension (ms-vscode.cpptools) and is
    // the right adapter for the `*-pc-windows-msvc` toolchain, which produces
    // PDBs. The CodeLLDB alternative is included below for anyone on a GNU
    // toolchain.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug standalone (rendering)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build standalone (debug)",
            "program": "${workspaceFolder}/modules/target/debug/pill_standalone.exe",
            "args": [],
            "stopAtEntry": false,
            // The host resolves `extensions/` relative to the process working
            // directory and expects to be launched from the engine workspace
            // root, which is `modules/`. Launching from anywhere else fails
            // with "optional module <name> has no directory under extensions/".
            "cwd": "${workspaceFolder}/modules",
            "environment": [
                {
                    // Required by `HostConfig::from_environment`; there is no
                    // other source for it. Relative to the workspace root above.
                    "name": "PROJECT_PATH",
                    "value": "../examples/project_rs"
                }
            ],
            // Optional modules are built into `target/hot/build`, not
            // `target/debug`, and are loaded from unique temporary copies that
            // carry no PDB beside them. Naming both build outputs lets the
            // debugger find module symbols when the host loads a module at
            // runtime. Without them a line breakpoint in a module's `lib.rs`
            // can bind to an unrelated crate's `lib.rs` by filename alone.
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/modules/target/hot/build/debug",
                    "${workspaceFolder}/modules/target/debug"
                ],
                "searchMicrosoftSymbolServer": false
            },
            "console": "integratedTerminal"
        },
        {
            // Use this one for breakpoints inside registered systems.
            "name": "Debug standalone (no hot patch)",
            "type": "cppvsdbg",
            "request": "launch",
            "preLaunchTask": "build standalone (debug, no hot patch)",
            "program": "${workspaceFolder}/modules/target/debug/pill_standalone.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}/modules",
            "environment": [
                {
                    "name": "PROJECT_PATH",
                    "value": "../examples/project_rs"
                }
            ],
            "symbolOptions": {
                "searchPaths": [
                    "${workspaceFolder}/modules/target/hot/build/debug",
                    "${workspaceFolder}/modules/target/debug"
                ],
                "searchMicrosoftSymbolServer": false
            },
            "console": "integratedTerminal"
        },
        {
            // Alternative adapter: CodeLLDB (vadimcn.vscode-lldb). Kept for
            // GNU-toolchain builds; on windows-msvc prefer cppvsdbg above,
            // whose PDB support is stronger.
            "name": "Debug standalone (CodeLLDB)",
            "type": "lldb",
            "request": "launch",
            "preLaunchTask": "build standalone (debug)",
            "program": "${workspaceFolder}/modules/target/debug/pill_standalone.exe",
            "args": [],
            "cwd": "${workspaceFolder}/modules",
            "env": {
                "PROJECT_PATH": "../examples/project_rs"
            }
        }
    ]
}
