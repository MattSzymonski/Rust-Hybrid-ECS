<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- This project is a Roslyn source generator; it is only ever consumed
         as an analyzer, never shipped or executed directly. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- `PublishAot` propagates from the project being AOT-published; an
         analyzer on netstandard2.0 must never be AOT-compiled itself. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
