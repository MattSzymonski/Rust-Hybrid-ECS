<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- This project is a Roslyn analyzer; it is only ever consumed as one,
         never shipped or executed directly. -->
    <IsRoslynComponent>true</IsRoslynComponent>
    <!-- `PublishAot` propagates from the project being AOT-published; an
         analyzer on netstandard2.0 must never be AOT-compiled itself. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- Release tracking: every rule is listed in AnalyzerReleases.Unshipped.md
       so RS2008 is satisfied and the rule set stays reviewable in one place. -->
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
  </ItemGroup>

</Project>
